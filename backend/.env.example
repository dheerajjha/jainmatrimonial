# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL with Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/jain_matrimonial?schema=public

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d

# Twilio (for OTP SMS)
# Set to 'development_mode' to log OTP to console instead of sending SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Email (for notifications - optional, not currently used)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

# App Configuration
APP_URL=http://localhost:3000

# Development Mode
# When TWILIO_ACCOUNT_SID is set to 'development_mode', OTPs are logged to console
# Use this for local development without Twilio credentials

# Admin Panel Configuration
ADMIN_EMAIL=admin@jainmatrimony.com
ADMIN_PASSWORD=admin123_change_in_production
ADMIN_COOKIE_SECRET=your_admin_cookie_secret_change_in_production
ADMIN_SESSION_SECRET=your_admin_session_secret_change_in_production
