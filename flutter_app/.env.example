# Flutter Environment Configuration Example
#
# To use these variables, run your app with --dart-define:
#
# Development:
# flutter run --dart-define=API_URL=http://localhost:5000/api --dart-define=ENVIRONMENT=development
#
# Production:
# flutter run --dart-define=API_URL=https://your-production-server.com/api --dart-define=ENVIRONMENT=production --dart-define=DEBUG_LOGS=false
#
# Build for web:
# flutter build web --dart-define=API_URL=https://your-production-server.com/api --dart-define=ENVIRONMENT=production

# Backend API URL (required)
API_URL=http://localhost:5000/api

# Environment (development, staging, production)
ENVIRONMENT=development

# Enable debug logging (true/false)
DEBUG_LOGS=true
